<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Capture tile: videos with game sound / microphone, in a foreground service -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Hugminn"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- long press on the quick settings tile opens Hugminn's settings instead of the app info -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- app shortcuts: opens the Control Center or the game switcher, then finishes right away -->
        <activity
            android:name=".ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- optional extra app icons (off by default, switched on in the settings), so frontends that only
             list apps can start the Control Center or the game switcher too -->
        <activity-alias
            android:name=".CcApp"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_shortcut_cc"
            android:label="@string/app_cc"
            android:targetActivity=".ShortcutActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".SwitcherApp"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_shortcut_switcher"
            android:label="@string/app_switcher"
            android:targetActivity=".ShortcutActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Android's "Add shortcut" list (widgets/shortcuts picker); frontends like Cocoon read these -->
        <activity-alias
            android:name=".CcShortcut"
            android:exported="true"
            android:icon="@mipmap/ic_shortcut_cc"
            android:label="@string/app_cc"
            android:targetActivity=".ShortcutActivity">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".SwitcherShortcut"
            android:exported="true"
            android:icon="@mipmap/ic_shortcut_switcher"
            android:label="@string/app_switcher"
            android:targetActivity=".ShortcutActivity">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- device test: checks what Hugminn can use, then a summary to share -->
        <activity
            android:name=".DeviceTestActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Capture: asks for the screen capture, then the service keeps it running -->
        <activity
            android:name=".ProjectionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:taskAffinity="io.github.ninte86hl.hugminn.capture"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- quick settings tile: opens the Control Center without a button -->
        <service
            android:name=".CcTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_cc"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".SetupActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".PauseActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:taskAffinity="io.github.ninte86hl.hugminn.pause"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />


        <activity
            android:name=".FeedbackActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".WifiPasswordActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />



        <!-- only for reading media sessions (music tile); no notifications are read -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Hugminn"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".HugminnService"
            android:exported="true"
            android:label="Hugminn"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
